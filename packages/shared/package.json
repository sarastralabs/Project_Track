    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@sarastra/eslint-config": "workspace:*",
    "@sarastra/tsconfig": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  }
}
