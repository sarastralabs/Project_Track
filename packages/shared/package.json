{
  "name": "@sarastra/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod schemas, enums, and types for Sarastra Hub",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
