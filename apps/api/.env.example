# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
APP_URL=http://localhost:3000

# Local Docker Mongo (see docker-compose.yml) — host port 28018
MONGODB_URI=mongodb://127.0.0.1:28018/?directConnection=true
MONGODB_DB_NAME=sarastra_hub

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-at-least-32-char-secret-value

# --- Later / optional ---
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465
# ZOHO_SMTP_USER=
# ZOHO_SMTP_PASS=
# ZOHO_FROM_EMAIL=
# OCI_S3_ENDPOINT=
# OCI_S3_REGION=
# OCI_S3_BUCKET=
# OCI_S3_ACCESS_KEY=
# OCI_S3_SECRET_KEY=
