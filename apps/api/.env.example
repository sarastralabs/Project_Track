# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
# Public URL the browser uses (web app). Auth cookies are issued for this origin.
APP_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001

# Local Docker Mongo (see docker-compose.yml) — host port 28018
MONGODB_URI=mongodb://127.0.0.1:28018/?directConnection=true
MONGODB_DB_NAME=sarastra_hub

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-at-least-32-char-secret-value