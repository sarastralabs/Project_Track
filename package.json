{
  "name": "sarastra-hub",
  "private": true,
  "version": "0.0.0",
  "description": "Sarastra Hub monorepo — project tracking API for Sarastra Labs",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@sarastra/eslint-config": "workspace:*",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}
